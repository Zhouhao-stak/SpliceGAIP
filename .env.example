# SpliceGAIP 大模型配置模板
#
# 用法：复制本文件为 .env（放在 SpliceGAIP.exe 同目录，或项目根目录），
#      填入自己的密钥，然后重新启动程序。密钥只保存在本机，不会写进任何报告。
#
# 说明：任何一项缺失都会自动回退到「离线确定性模式」，分析结果完全一致，
#      只是没有 AI 解读/注释/假设等增强内容。
#      也可以在界面「AI 解读 → 模型配置」里直接填写，保存后无需重启。

# --- 必填：OpenAI 兼容端点 -------------------------------------------------
# 常见写法：
#   DeepSeek    https://api.deepseek.com          （无需 /v1）
#   OpenAI      https://api.openai.com/v1
#   月之暗面    https://api.moonshot.cn/v1
#   阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 vLLM   http://127.0.0.1:8000/v1
MODEL_API_BASE_URL=https://api.deepseek.com

# 你的 API Key
MODEL_API_KEY=sk-换成你自己的密钥

# 默认模型名；留空则整条 AI 链路自动关闭
# DeepSeek-V4.1-Flash 的官方模型名就是 deepseek-flash
# （旧名 deepseek-v4-flash 仍被接受，但已不推荐）
MODEL_NAME=deepseek-flash

# --- DeepSeek 推理模式（thinking）------------------------------------------
# V4.1-Flash 默认开启 thinking 且推理强度为 high，会带来两个坑：
#   1) 携带 tools 的请求必须把 reasoning_content 原样回传，否则返回 400；
#   2) thinking 模式下 temperature 会被忽略。
# 因此 SpliceGAIP 按调用类型分别处理：
#   auto（推荐）
#       智能体工具调用 → 自动关闭 thinking（保证多轮工具调用不报错、速度最快）
#       报告 AI 解读   → 开启 thinking（叙述与假设更严谨）
#   disabled  全部关闭：最快、temperature 生效
#   enabled   全部开启：最慢；若端点不回传 reasoning_content，工具调用可能失败
MODEL_THINKING=auto

# 开启 thinking 时的推理强度：留空=服务商默认(high)
# 可选 minimal / low / medium / high / xhigh / max
MODEL_REASONING_EFFORT=low

# --- 可选：分角色模型 -------------------------------------------------------
# 分析型模型（负责数值相关叙述）与审查模型（负责挑错）。不填则用 MODEL_NAME。
# MODEL_ANALYST_NAME=deepseek-flash
# MODEL_CRITIC_NAME=deepseek-flash

# --- 可选：成本与语言控制 ---------------------------------------------------
# 单次调用超时（秒）
# MODEL_API_TIMEOUT_SECONDS=600
# 增强层单次调用超时（秒）
# SPLICEGAIP_LLM_TIMEOUT=120
# 每次分析最多调用多少次模型（超预算自动降级为确定性输出）
# SPLICEGAIP_LLM_MAX_CALLS=16
# 最多给多少个候选基因生成 AI 注释
# SPLICEGAIP_LLM_MAX_GENES=8
# 生成语言：auto（跟随提问语言）/ zh / en
# SPLICEGAIP_LLM_LANG=auto
# 只启用部分能力（逗号分隔），例如只做解读与假设：
# SPLICEGAIP_LLM_FEATURES=understand,interpret,hypotheses
# 强制关闭模型（即使配置了密钥）：
# SPLICEGAIP_LLM_ENABLED=false

# --- 可选：其他 -------------------------------------------------------------
# 关闭在线 PubMed 检索（离线环境建议关闭，可显著提速）
# SPLICEGAIP_ENABLE_PUBMED=false
# 运行时状态目录（SQLite 必须落在本地盘，不能是 NFS 挂载目录）
# SPLICEGAIP_RUNTIME_ROOT=C:/Users/你的用户名/AppData/Local/Temp/splicegaip
